# Python bytecode & cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Git & Antigravity files
.git/
.gitignore

# Virtual environment & logs
venv/
.venv/
*.log
*.webarchive

# Exclude heavy static image assets and local data stores from Docker container build context
# (All records, spins, and cover images are hosted and served from Firestore and GCS bucket: universal-trail-492014-n5-vinyl-vault-data)
data_store/
static/extracted_covers/*
!static/extracted_covers/.gitkeep
static/uploads/*
!static/uploads/.gitkeep

