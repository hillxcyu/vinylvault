# Python bytecode & cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Git & Antigravity files
.git/
.gitignore

# Virtual environment & logs
venv/
.venv/
*.log
*.webarchive

# Exclude local data stores and uploaded media from Docker container build context
# (All records, spins, chronicle, and assets are stored and retrieved dynamically from Firestore and GCS bucket)
data_store/

static/extracted_covers/*
!static/extracted_covers/.gitkeep
static/uploads/*
!static/uploads/.gitkeep

